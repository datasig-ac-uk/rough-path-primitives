@PACKAGE_INIT@

if(CMAKE_VERSION VERSION_LESS 3.3)
set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
"MyProj requires CMake 3.3 or later"
)
set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
return()
endif()


include(CMakeFindDependencyMacro)


# Core components
include("${CMAKE_CURRENT_LIST_DIR}/RoughPathPrimitivesTargets.cmake")

# Dependency helpers
include("${CMAKE_CURRENT_LIST_DIR}/RoughPathPrimitivesDependencies.cmake")


set(_known_components
    GPU
)
set(_components_to_load)

foreach(_comp IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    if (NOT ${_comp} IN_LIST _known_components)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "Unrecognised component ${_comp}")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif()


    _rpp_check_dependencies(${CMAKE_FIND_PACKAGE_NAME} ${_comp})

    if(${CMAKE_FIND_PACKAGE_NAME}_${_comp}_AVAILABLE)
        list(APPEND _components_to_load ${_comp})
    elseif (${CMAKE_FIND_PACKAGE_NAME}_FIND_REQUIRED_${_comp})
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif()
endforeach()


foreach(_comp ${_components_to_load})
    include("${CMAKE_CURRENT_LIST_DIR}/RoughPathPrimitivesTargets_${_comp}.cmake")
endforeach()






