{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "RPP_ENABLE_TESTS": "ON",
        "RPP_ENABLE_BENCHMARKS": "ON"
      }
    },
    {
      "name": "cuda-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CUDA_COMPILER": "/usr/local/cuda/bin/nvcc",
        "CUDAToolkit_ROOT": "/usr/local/cuda",
        "CMAKE_CUDA_ARCHITECTURES": "native"
      },
      "environment": {
        "CUDA_PATH": "/usr/local/cuda",
        "CUDACXX": "/usr/local/cuda/bin/nvcc",
        "PATH": "/usr/local/cuda/bin:$penv{PATH}",
        "LD_LIBRARY_PATH": "/usr/local/cuda/lib64:$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RPP_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RPP_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "debug-cuda",
      "displayName": "Debug CUDA (Linux)",
      "inherits": "cuda-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/cmake-build-debug-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RPP_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "release-cuda",
      "displayName": "Release CUDA (Linux)",
      "inherits": "cuda-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/cmake-build-release-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RPP_ENABLE_CUDA": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug-cuda",
      "configurePreset": "debug-cuda",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "release-cuda",
      "configurePreset": "release-cuda",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-cuda",
      "configurePreset": "debug-cuda",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-cuda",
      "configurePreset": "release-cuda",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
